@{
    ViewBag.Title = "Лабораторная №2";
}

<main class="container mt-4 mb-5">
    <h2>Лабораторная работа №2</h2>
    <h4 class="text-muted">Тема: Ремонт техники МЧС (Минск) - Бадеев Д.А.</h4>
    <hr />

    <h5>Список запчастей (пример)</h5>
    <ol type="A" class="mb-4 text-muted" style="font-size: 0.9rem;">
        <li>Двигатель ЯМЗ-236</li>
        <li>Гидронасос ПН-40УВ</li>
        <li>Пожарные рукава (комплект)</li>
        <li>Светогудовое устройство (СГУ)</li>
        <li>Коробка отбора мощности</li>
    </ol>

    <h5>Форма заявки на ремонт</h5>
    <form action="#" method="POST" class="w-50 mt-3">

        <!-- Исправлено: добавлена связь через for и id -->
        <label for="equipmentType" class="form-label text-muted">Тип техники:</label>
        <select class="form-select mb-3" name="itemSelect" id="equipmentType">
            <option>Автоцистерна (АЦ)</option>
            <option>Автолестница (АЛ)</option>
            <option>Легковой штабной автомобиль</option>
        </select>

        <div class="form-check text-muted" style="font-size: 0.85rem;">
            <input class="form-check-input" type="checkbox" name="urgent" id="chk1">
            <label class="form-check-label" for="chk1">Срочный ремонт (Боевой расчет)</label>
        </div>
        <div class="form-check mb-3 text-muted" style="font-size: 0.85rem;">
            <input class="form-check-input" type="checkbox" name="parts" id="chk2">
            <label class="form-check-label" for="chk2">Требуется закупка деталей</label>
        </div>

        <div class="mb-3 text-muted" style="font-size: 0.85rem;">
            <!-- Исправлено: заголовок группы заменен на параграф, так как это не прямой лейбл для одного контроля -->
            <p class="mb-2">Степень поломки:</p>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="damageLevel" id="radio1" value="1" checked>
                <label class="form-check-label" for="radio1">Легкая</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="damageLevel" id="radio2" value="2">
                <label class="form-check-label" for="radio2">Средняя</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="damageLevel" id="radio3" value="3">
                <label class="form-check-label" for="radio3">Капитальный ремонт</label>
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <label for="login" class="col-sm-3 col-form-label text-muted" style="font-size: 0.85rem;">Нач. гаража:</label>
            <div class="col-sm-9">
                <input type="text" class="form-control" id="login" name="login" value="badeev@mchs.gov.by">
            </div>
        </div>

        <div class="row mb-4 align-items-center">
            <label for="password" class="col-sm-3 col-form-label text-muted" style="font-size: 0.85rem;">Пароль (ПАС):</label>
            <div class="col-sm-9">
                <input type="password" class="form-control" id="password" name="password" value="123456">
            </div>
        </div>

        <button type="submit" class="btn-unique">Отправить заявку</button>
    </form>
</main>