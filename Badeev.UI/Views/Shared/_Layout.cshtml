<!DOCTYPE html>
<html lang="ru">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Бадеев Д.А. (40332)</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ШАПКА -->
    <header>
        <div class="container">
            <nav class="navbar navbar-expand-md navbar-dark bg-dark">
                <!-- Бренд -->
                <a class="navbar-brand badge bg-secondary fs-6" asp-controller="Home" asp-action="Index">Бадеев</a>

                <!-- Меню сайта (вызов компонента) -->
                @await Component.InvokeAsync("Menu")

                <!-- Информация пользователя (вызов частичного представления) -->
                <partial name="_UserInfoPartial" />
            </nav>
        </div>
    </header>

    <!-- ОСНОВНОЙ КОНТЕНТ -->
    @RenderBody()

    <!-- ПОДВАЛ -->
    <footer>
        <div class="container">
            <div class="navbar navbar-dark navbar-expand-md bg-dark">
                <div class="navbar-nav ms-auto">
                    <a class="nav-item nav-link" href="http://www.facebook.com"><i class="fa-brands fa-facebook-f fa-2x"></i></a>
                    <a class="nav-item nav-link" href="http://www.vk.com"><i class="fa-brands fa-vk fa-2x"></i></a>
                    <a class="nav-item nav-link" href="http://www.twitter.com"><i class="fa-brands fa-twitter fa-2x"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>