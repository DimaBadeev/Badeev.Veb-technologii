@page
@model Badeev.UI.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container my-5">
    <h1 class="text-center">@ViewData["Title"]</h1>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <section class="card shadow-sm p-4 border-dark">
                <!-- Начало формы -->
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" enctype="multipart/form-data" method="post">
                    <h2 class="h5 text-muted text-center mb-4">Создать новый профиль сотрудника</h2>
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Электронная почта (Email)</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password">Пароль</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword">Подтвердите пароль</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <!-- Поле выбора файла аватара -->
                    <div class="mb-3">
                        <label asp-for="Input.Avatar" class="form-label text-muted" style="font-size: 0.85rem;">Фото профиля:</label>
                        <input asp-for="Input.Avatar" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Input.Avatar" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn-unique btn-lg">Зарегистрироваться</button>
                </form>
                <!-- Конец формы -->
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}